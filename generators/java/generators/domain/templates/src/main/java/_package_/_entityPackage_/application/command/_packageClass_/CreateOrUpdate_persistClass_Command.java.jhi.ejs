  @CommandHandler
  @RequiredArgsConstructor
  public static class Handler implements BaseCommandHandler<CreateOrUpdate<%= persistClass %>Command, <%= persistClass %>> {
    private final <%= persistClass %>PortCommand <%= persistInstance %>PortCommand;
    private final <%= persistClass %>PortQuery <%= persistInstance %>PortQuery;
    private final <%= persistClass %>Mapper <%= persistInstance %>Mapper = <%= persistClass %>Mapper.INSTANCE;

    @Override
    public <%= persistClass %> handle(CreateOrUpdate<%= persistClass %>Command command) {

        Validator.hasRule(command.getId() == null || <%= persistInstance %>PortQuery.existsById(command.getId())
        , Exceptions.EntityNotFound);

        var domain = <%= persistInstance %>Mapper.toDomain(command);
        if (domain.getId() == null) {
            domain.prepareForCreation();
        } else {
            domain.prepareForUpdate();
        }

        <%= persistInstance %>PortCommand.save(domain);
        return domain;

    }
  }

